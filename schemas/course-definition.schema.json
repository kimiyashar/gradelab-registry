{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimiyashar.github.io/gradelab-registry/schemas/course-definition.schema.json",
  "title": "GradeLab shared course definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseKey",
    "institution",
    "term",
    "courseCode",
    "title",
    "revision",
    "status",
    "gradingModel",
    "categories",
    "rules",
    "sources",
    "verifiedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "courseKey": {
      "type": "string",
      "pattern": "^[-a-z0-9]+:[-a-z0-9]+:[-a-z0-9]+:[-a-z0-9]+$"
    },
    "institution": {
      "type": "string"
    },
    "term": {
      "type": "string"
    },
    "courseCode": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "published"
    },
    "gradingModel": {
      "enum": [
        "weighted",
        "points",
        "unverified"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "weight"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "object"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string"
    }
  }
}
